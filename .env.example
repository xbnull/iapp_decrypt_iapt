DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iapp_user
DB_PASSWORD=change_me
DB_NAME=iapp_saas
APP_STORAGE=/www/wwwroot/iapp_saas/storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOW_REGISTER=0

# Secure download / cache
ZIP_ENCRYPTION=1
SOURCE_CACHE_TTL_MINUTES=30
DOWNLOAD_CACHE_TTL_MINUTES=30
RSA_PRIVATE_KEY_PATH=/www/wwwroot/iapp_saas/keys/server_private.pem
RSA_PUBLIC_KEY_PATH=/www/wwwroot/iapp_saas/keys/server_public.pem

# sokey+dexkey 联合枚举加速（服务端控制）
# 先验证 classes*.dex 中提取到的 f.b()/dexkey 候选；只作为提示，失败会继续完整枚举。
IAPT_JOINT_DEX_HINT_FIRST=1
# 没有可用 DEX 提示时，先按 sokey 优先级逐批完成全 dexkey 范围；0 表示关闭。
IAPT_JOINT_FAST_HIDDEN_LIMIT=256
IAPT_JOINT_FAST_HIDDEN_BATCH_SIZE=8

# V28: true no-metadata sokey+dexkey joint enumeration.
# Does not rely on DEX hints or timestamps.  It scans one complete dex range per
# sokey in native workers, avoiding repeated setup for thousands of tiny tiles.
IAPT_JOINT_NO_HINT_HIDDEN_MAJOR=1
IAPT_JOINT_NO_HINT_MIN_HIDDEN=16
